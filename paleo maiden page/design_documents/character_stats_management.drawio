                <mxCell id="daHsZOGf6jMVClJ8tzDP-41" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Design Intent&lt;/h1&gt;&lt;div&gt;To allow for a character&#39;s stats to be manipulated both during combat and outside of it (camps, events etc.).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Needs to accomodate temporary stat changes as well (buffs/debuffs, events)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Original CharacterData should not be touched, as this is the template for instantiating characters&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Base stats are the values that the current character actually has when unaffected by any statuses/unique effects&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Final stats on the other hand represent the actual stat values after all statuses/unique effects are accounted for&lt;/div&gt;" vertex="1">
                    <mxGeometry height="320" width="240" as="geometry"/>
                </mxCell>
